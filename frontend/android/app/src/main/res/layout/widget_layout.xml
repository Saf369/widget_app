<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="20dp">

    <!-- Top Tab Bar (Pill Shape) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/tab_container_bg"
        android:padding="4dp">
        
        <TextView android:id="@+id/tab_hour" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:text="Hour" 
            android:textAlignment="center" 
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF" 
            android:textSize="14sp"
            android:textStyle="bold" 
            android:background="@drawable/tab_active_bg"/>
            
        <TextView android:id="@+id/tab_day" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:text="Day" 
            android:textAlignment="center" 
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textColor="#45474A" 
            android:textStyle="bold" />
            
        <TextView android:id="@+id/tab_week" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:text="Week" 
            android:textAlignment="center" 
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textColor="#45474A" 
            android:textStyle="bold" />
            
        <TextView android:id="@+id/tab_month" 
            android:layout_width="0dp" 
            android:layout_height="wrap_content" 
            android:layout_weight="1" 
            android:text="Month" 
            android:textAlignment="center" 
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp"
            android:textColor="#45474A" 
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Container (Rounded Card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_content_bg"
        android:layout_marginTop="20dp">
        
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Class"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111315" />
            
        <TextView
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="10:00 AM - Artificial Intelligence\nRoom: Hall 3"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:textColor="#45474A" />
    </LinearLayout>
</LinearLayout>
