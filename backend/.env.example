# ==============================================================================
# Gemini AI Configuration
# ==============================================================================
GEMINI_API_KEY="your-gemini-api-key"
AI_MODEL="gemini-3.8-flash"

# ==============================================================================
# Firebase Admin SDK Configuration
# ==============================================================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_STORAGE_BUCKET="your-firebase-project-id.firebasestorage.app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# Firebase Client API Keys
# ==============================================================================
FIREBASE_WEB_API_KEY="AIzaSy..."
FIREBASE_ANDROID_API_KEY="AIzaSy..."

# ==============================================================================
# Google OAuth 2.0 Credentials
# ==============================================================================
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-client-secret"
GOOGLE_OAUTH_ANDROID_CLIENT_ID="your-android-client-id.apps.googleusercontent.com"
